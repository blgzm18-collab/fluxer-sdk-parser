{
  "name": "@fluxerjs/builders",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.2.0",
  "description": "Builders for Fluxer messages and embeds",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluxerjs/core.git",
    "directory": "packages/builders"
  },
  "bugs": "https://github.com/fluxerjs/core/issues",
  "homepage": "https://fluxerjs.blstmo.com",
  "keywords": [
    "fluxer",
    "embed",
    "builder",
    "sdk"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fluxerjs/types": "2.2.0",
    "@fluxerjs/util": "2.2.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  }
}