/**
 * Extended Map with utility methods for key-value collections.
 */
declare class Collection<K, V> extends Map<K, V> {
    /** First value, or the first `amount` values. */
    first(): V | undefined;
    first(amount: number): V[];
    /** Last value, or the last `amount` values (no full-array alloc for a single item). */
    last(): V | undefined;
    last(amount: number): V[];
    /** One random value, or `amount` unique random values. */
    random(): V | undefined;
    random(amount: number): V[];
    find(fn: (value: V, key: K) => boolean): V | undefined;
    findKey(fn: (value: V, key: K) => boolean): K | undefined;
    filter(fn: (value: V, key: K) => boolean): Collection<K, V>;
    map<T>(fn: (value: V, key: K) => T): T[];
    some(fn: (value: V, key: K) => boolean): boolean;
    every(fn: (value: V, key: K) => boolean): boolean;
    reduce<T>(fn: (acc: T, value: V, key: K) => T, initialValue: T): T;
    partition(fn: (value: V, key: K) => boolean): [Collection<K, V>, Collection<K, V>];
    /** Iterate without allocating; returns `this` for chaining. */
    each(fn: (value: V, key: K, collection: this) => void): this;
    tap(fn: (collection: this) => void): this;
    clone(): Collection<K, V>;
    concat(...collections: ReadonlyCollection<K, V>[]): Collection<K, V>;
    sort(compareFn?: (a: V, b: V, aKey: K, bKey: K) => number): this;
    toJSON(): V[];
    toString(): string;
}
/** Read-only view of a Collection (e.g. for method return types). */
type ReadonlyCollection<K, V> = Omit<Collection<K, V>, 'set' | 'delete' | 'clear'>;

/** Options for {@link LimitedCollection}. */
interface LimitedCollectionOptions<K, V> {
    /**
     * Maximum number of entries. Values `<= 0` or `Infinity` mean unbounded.
     * @default Infinity
     */
    maxSize?: number;
    /** Called after an entry is FIFO-evicted to make room for a new key. */
    onEvict?: (key: K, value: V) => void;
}
/**
 * {@link Collection} with optional FIFO eviction when a new key is inserted at capacity.
 *
 * Construction is Map-safe: options are never passed to `super()`, so subclasses can call
 * `super({ maxSize, onEvict })` without Map treating the options object as an iterable.
 */
declare class LimitedCollection<K, V> extends Collection<K, V> {
    readonly maxSize: number;
    readonly onEvict: ((key: K, value: V) => void) | null;
    /** Guard against re-entrant eviction while `onEvict` runs. */
    private _evicting;
    constructor(options?: LimitedCollectionOptions<K, V>);
    /** Whether this collection enforces a finite capacity. */
    get bounded(): boolean;
    /**
     * Insert or update an entry. When at capacity and `key` is new, the oldest entry is
     * removed (FIFO by Map insertion order) and `onEvict` is invoked if set.
     */
    set(key: K, value: V): this;
    /**
     * Remove entries matching `filter` (or all if omitted). Returns count removed.
     * Does not invoke `onEvict` — callers that need cascade teardown should handle it.
     */
    sweep(filter?: (value: V, key: K) => boolean): number;
    /** Clone into a new LimitedCollection with the same limits (no `onEvict` callback). */
    clone(): LimitedCollection<K, V>;
}

export { Collection, LimitedCollection, type LimitedCollectionOptions, type ReadonlyCollection };
